# These files run on Ubuntu, so they must keep LF endings even when
# checked out on Windows (core.autocrlf=true would make them CRLF and
# bash fails with "$'\r': command not found").
*.sh                           text eol=lf
*.service                      text eol=lf
*.conf                         text eol=lf
autoinstall/user-data*         text eol=lf
autoinstall/meta-data          text eol=lf
firstboot/*.before-*           text eol=lf

*.py                           text eol=lf

# The update catalog is checked byte for byte against the SHA-256
# in catalog/index.json, so git must never change its line endings.
catalog/**                     -text
tests/catalog-fixtures/**      -text
