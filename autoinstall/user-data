#cloud-config
autoinstall:
  version: 1

  interactive-sections:
    - locale
    - keyboard
    - timezone
    - network
    - storage
    - identity

  ssh:
    install-server: true
    allow-pw: true

  packages:
    - openssh-server
    - curl
    - wget
    - git

 # package_update: true
 # package_upgrade: true

  updates: security

  late-commands:
    - mkdir -p /target/root/pinpoint
    - cp -r /cdrom/pinpoint/* /target/root/pinpoint/

    - cp /target/root/pinpoint/pinpoint-firstboot.sh /target/usr/local/bin/
    - curtin in-target -- chmod +x /usr/local/bin/pinpoint-firstboot.sh

    - cp /target/root/pinpoint/pinpoint-web-credentials.sh /target/usr/local/bin/pinpoint-web-credentials
    - curtin in-target -- chmod 755 /usr/local/bin/pinpoint-web-credentials

    - cp /target/root/pinpoint/pinpoint-login-hook.sh /target/etc/profile.d/pinpoint-login-hook.sh
    - curtin in-target -- chmod 644 /etc/profile.d/pinpoint-login-hook.sh

    - cp /target/root/pinpoint/pinpoint-firstboot.service /target/etc/systemd/system/
    - mkdir -p /target/etc/systemd/system/getty@tty1.service.d
    - cp /target/root/pinpoint/getty-tty1.conf /target/etc/systemd/system/getty@tty1.service.d/pinpoint.conf
    - curtin in-target -- systemctl enable pinpoint-firstboot.service

  shutdown: reboot
